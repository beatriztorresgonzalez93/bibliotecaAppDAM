<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDevolucion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/outline"
    android:backgroundTint="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Cabecera: Título/Autor + Chip DEVUELTO -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvTituloAutor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Crepúsculo · Stephenie Meyer"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/chipEstado"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/chipEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_devuelto"
                android:text="DEVUELTO"
                android:textAllCaps="true"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Ejemplar (secundario) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvCodigoInventario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🏷 Ejemplar: INV-00091-2"
            android:textColor="@color/onSurfaceVariant"
            android:textSize="13sp" />

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/divider_soft"/>

        <!-- Usuario -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvUsuarioNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Alba Navarro Gil"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvUsuarioEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="📧 alba.navarro.gil@demo.com"
            android:textColor="@color/onSurfaceVariant"
            android:textSize="13sp"/>

        <!-- Fechas -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvFechaDevolucion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="✅ Devuelto: Feb 18, 2026 · 22:48"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvFechaPrestamo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📦 Prestado: Jan 20, 2026 · 17:48"
            android:textColor="@color/onSurfaceVariant"
            android:textSize="13sp"/>

        <!-- Opcional PRO: duración -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDuracion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="⏱ Duración: 29 días"
            android:textColor="@color/onSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>