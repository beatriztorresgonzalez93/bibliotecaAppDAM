<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- ========= CABECERA USUARIO ========= -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Nombre -->
                <TextView
                    android:id="@+id/tvNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="16sp"
                    app:autoSizeMaxTextSize="22sp"
                    app:autoSizeStepGranularity="1sp" />

                <!-- Email -->
                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#4B5563"
                    android:drawableStart="@drawable/ic_email_20"
                    android:drawablePadding="8dp"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="16sp" />

                <!-- Rol -->
                <TextView
                    android:id="@+id/tvRol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#4B5563"
                    android:drawableStart="@drawable/ic_user_20"
                    android:drawablePadding="8dp"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="16sp" />

                <!-- AVISO -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAvisoVencidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#FFCDD2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:orientation="horizontal"
                        android:background="#FFEBEE"
                        android:gravity="center_vertical">

                        <!-- Icono fijo -->
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="10dp"
                            android:gravity="center"
                            android:text="⚠️"
                            android:textSize="16sp" />

                        <!-- Texto adaptable -->
                        <TextView
                            android:id="@+id/tvAvisoVencidos"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            android:textColor="#B71C1C"

                            android:maxLines="3"
                            android:ellipsize="end"
                            android:breakStrategy="balanced"

                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="12sp"
                            app:autoSizeMaxTextSize="16sp"
                            app:autoSizeStepGranularity="1sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- KPIs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- PRESTAMOS -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E5E7EB">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Préstamos"
                                android:textSize="12sp"
                                android:textColor="#6B7280" />

                            <TextView
                                android:id="@+id/tvPrestamosActivos"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textStyle="bold"
                                android:textColor="#111827"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:breakStrategy="balanced"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeMaxTextSize="16sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- MULTAS € -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E5E7EB">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pendiente €"
                                android:textSize="12sp"
                                android:textColor="#6B7280" />

                            <TextView
                                android:id="@+id/tvMultasPendientes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textStyle="bold"
                                android:textColor="#111827"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:breakStrategy="balanced"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeMaxTextSize="16sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Nº MULTAS -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E5E7EB">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nº multas"
                                android:textSize="12sp"
                                android:textColor="#6B7280" />

                            <TextView
                                android:id="@+id/tvNumMultasPendientes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textStyle="bold"
                                android:textColor="#111827"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:breakStrategy="balanced"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeMaxTextSize="16sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========= CARD ESTADÍSTICAS ========= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatsUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="18dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chart_20"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvStatsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Estadísticas del usuario"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#111827" />
                </LinearLayout>

                <!-- Filas -->
                <TextView
                    android:id="@+id/tvTotalPrestamos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Total préstamos: —"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:drawableStart="@drawable/ic_book_20"
                    android:drawablePadding="8dp" />

                <TextView
                    android:id="@+id/tvTotalMultas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Total multas: —"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:drawableStart="@drawable/ic_warning_20"
                    android:drawablePadding="8dp" />

                <TextView
                    android:id="@+id/tvTotalPagado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Total pagado en multas: —"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:drawableStart="@drawable/ic_euro_20"
                    android:drawablePadding="8dp" />

                <TextView
                    android:id="@+id/tvTotalPendiente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Total pendiente en multas: —"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:drawableStart="@drawable/ic_clock_20"
                    android:drawablePadding="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========= LISTADO ========= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Préstamos activos"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#111827" />

        <TextView
            android:id="@+id/tvSinPrestamos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este usuario no tiene préstamos activos"
            android:textStyle="italic"
            android:textColor="#6B7280"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPrestamosActivos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingBottom="12dp" />

    </LinearLayout>

</ScrollView>