<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =========================
         TEMA PRINCIPAL APP
         ========================= -->
    <style name="Base.Theme.BibliotecaApp" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Paleta (verde salvia) -->
        <item name="colorPrimary">#5C8D89</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorPrimaryContainer">#4A716E</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>

        <item name="colorSecondary">#7FA9A4</item>
        <item name="colorOnSecondary">#1F2937</item>

        <!-- Tertiary (ripple/acento suave) -->
        <item name="colorTertiary">#88B6B0</item>
        <item name="colorOnTertiary">#1F2937</item>

        <!-- Fondo general -->
        <item name="android:colorBackground">#F8FAF9</item>

        <!-- Superficies (cards, menús, etc.) -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1F2937</item>

        <!-- Variante de surface (evita “lilas” raros por defecto en Material3) -->
        <item name="colorSurfaceVariant">#EEF5F4</item>
        <item name="colorOnSurfaceVariant">#42535A</item>

        <!-- Bordes/divisores -->
        <item name="colorOutline">#D6E3DF</item>

        <!-- Texto principal legacy -->
        <item name="android:textColorPrimary">#1F2937</item>

    </style>

    <style name="Theme.BibliotecaApp" parent="Base.Theme.BibliotecaApp" />


    <!-- =========================
         POPUP MENU (OVERFLOW ORDENAR)
         ========================= -->

    <!-- Se aplica desde la Toolbar con: app:popupTheme="@style/ThemeOverlay.Biblioteca.PopupMenu" -->
    <style name="ThemeOverlay.Biblioteca.PopupMenu" parent="ThemeOverlay.Material3.Light">
        <!-- ✅ Esto fuerza el estilo del menú overflow -->
        <item name="actionOverflowMenuStyle">@style/Widget.Biblioteca.PopupMenu</item>

        <!-- (opcional) también para popupMenu normal -->
        <item name="popupMenuStyle">@style/Widget.Biblioteca.PopupMenu</item>
    </style>

    <style name="Widget.Biblioteca.PopupMenu" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="itemTextColor">@color/popup_menu_text</item>
        <item name="itemBackground">@drawable/bg_popup_menu_item</item>
    </style>


    <style name="TextAppearance.Biblioteca.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Biblioteca.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Biblioteca.TitleCard" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Biblioteca.SubtitleCard" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Biblioteca.Empty" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:padding">24dp</item>
    </style>

    <style name="Widget.Biblioteca.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <style name="Widget.Biblioteca.ButtonPrimary" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Biblioteca.ButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Biblioteca.ButtonTonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">16dp</item>
    </style>

</resources>